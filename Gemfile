# The gems the site is built with.
#
# The site is a Jekyll site: the templates of the templates directory
# are rendered by Jekyll, and the lock file pins the version of every
# gem so a build is the same build everywhere.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# Ruby 3 took webrick out of the standard library, and jekyll serve
# needs it.
gem "webrick", "~> 1.8"
